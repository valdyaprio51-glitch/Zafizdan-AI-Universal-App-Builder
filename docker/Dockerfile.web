FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/web/package*.json ./apps/web/

RUN npm install

COPY packages/shared ./packages/shared
RUN npm run build --workspace=@zafizdan/shared

COPY apps/web ./apps/web
RUN npm run build --workspace=@zafizdan/web

EXPOSE 3000
CMD ["npm", "run", "start", "--workspace=@zafizdan/web"]
